  note = {Poster Presentation},
  poster = {pp_poster.pdf},
  preview = {pp.png},
  abstract = {This poster presents the implementation and benchmarking of Toeplitz strong extractors for QRNG post-processing across multiple hardware platforms. By comparing matrix-multiplication and FFT-based Toeplitz hashing, we demonstrate significant gains in speed and memory efficiency when extracting information-theoretically secure quantum randomness. Our optimized FFT implementation achieves up to 3.7 Gbps on an Nvidia Quadro GV100 GPU, confirming the practicality of high-throughput, secure randomness extraction for modern QRNG systems.}
