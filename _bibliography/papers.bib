  author = {K. S. V., Anurag and Raghavan, G. and P., Kanaka Raju},
  title = {Implementation and Evaluation of Toeplitz Strong Extractor for Post-Processing of QRNGs on Various Hardware Systems},
  booktitle = {International Conference on Quantum Technologies and Applications 2024 (ICQTA24)},
  year = {2024},
